rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function angemeldet() {
      return request.auth != null;
    }

    /**
     * E-Mail des angemeldeten Kontos in Kleinbuchstaben — oder '', wenn keine
     * bestätigte Adresse im Token steht. Freigaben laufen über die Adresse,
     * damit ein Zugang schon vor der ersten Anmeldung eingerichtet werden kann.
     */
    function eigeneEmail() {
      return angemeldet()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', null) != null
        ? request.auth.token.email.lower()
        : '';
    }

    function istMitglied(ownerId) {
      return eigeneEmail() != ''
        && exists(/databases/$(database)/documents/users/$(ownerId)/mitglieder/$(eigeneEmail()));
    }

    // ── Akquise-Daten (Leads) ───────────────────────────────────────────────
    // Einziges Dokument, das freigeschaltete Mitglieder sehen. Es enthält
    // ausschließlich Leads und den Terminlink — keine Umsätze, Rechnungen,
    // Angebote, Kunden oder Projekte.
    match /users/{ownerId}/data/akquise {
      allow read: if angemeldet()
        && (request.auth.uid == ownerId || istMitglied(ownerId));

      allow write: if angemeldet() && request.auth.uid == ownerId;

      // Mitglieder dürfen ausschließlich das Feld "leads" verändern,
      // den Terminlink nicht.
      allow update: if angemeldet()
        && istMitglied(ownerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leads']);
    }

    // ── Freigaben verwalten ─────────────────────────────────────────────────
    // Nur der Inhaber schreibt; das Mitglied darf seinen eigenen Eintrag lesen.
    match /users/{ownerId}/mitglieder/{mitgliedEmail} {
      allow read: if angemeldet()
        && (request.auth.uid == ownerId || eigeneEmail() == mitgliedEmail);
      allow write: if angemeldet() && request.auth.uid == ownerId;
    }

    // Zeiger E-Mail -> Arbeitsbereich, damit ein Mitglied nach der Anmeldung
    // findet, wo es eingeladen wurde. Verleiht für sich genommen keine Rechte:
    // maßgeblich für den Datenzugriff ist allein /users/{ownerId}/mitglieder.
    match /mitgliedschaften/{mitgliedEmail} {
      allow read: if angemeldet() && eigeneEmail() == mitgliedEmail;
      allow create: if angemeldet()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if angemeldet()
        && resource.data.ownerUid == request.auth.uid;
    }

    // ── Alle übrigen Daten: ausschließlich der Inhaber ───────────────────────
    match /users/{userId}/data/{document=**} {
      allow read, write: if angemeldet() && request.auth.uid == userId;
    }

    // Alle anderen Pfade sind gesperrt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
