{
  "functions": {
    "api/analyse.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "api/gesuche.ts": {
      "maxDuration": 180,
      "memory": 1024
    },
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/gesuche?lauf=cron",
      "schedule": "0 5 * * *"
    }
  ]
}
